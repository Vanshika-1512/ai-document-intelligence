# Backend — FastAPI environment variables
# Copy this file to .env for local development.
# On Render, set these in the Render dashboard → Environment tab (not in a file).
# Never commit your real .env to version control.

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# SQLite (default — data is ephemeral on Render's free tier):
DATABASE_URL=sqlite:///./documents.db
# PostgreSQL (recommended for persistent data on Render paid plan):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins.
# After deploying to Vercel, update this to your Vercel URL:
#   ALLOWED_ORIGINS=https://your-app.vercel.app
# ------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------
# Hugging Face model loading
# Local development (models already cached): set to 1
# Render / first-time deployment (download from HF Hub): set to 0
# ------------------------------------------------------------------
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# ------------------------------------------------------------------
# NLP Models (all open-source, no key required)
# ------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
SUMMARIZATION_MODEL=sshleifer/distilbart-cnn-12-6
QA_MODEL=distilbert-base-cased-distilled-squad
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
SPACY_MODEL=en_core_web_sm

# ------------------------------------------------------------------
# Optional: external LLM (leave blank to stay fully local)
# ------------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------------
# App behaviour
# ------------------------------------------------------------------
MAX_UPLOAD_MB=20
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
UPLOAD_DIR=./uploads
